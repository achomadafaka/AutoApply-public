# Relative paths resolve from backend/ when using the documented launcher.
AUTOAPPLY_DB_PATH=data/autoapply.db
AUTOAPPLY_SETTINGS_PATH=data/settings.json
AUTOAPPLY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTOAPPLY_DAILY_LIMIT=25

# Optional headed Fill & Review. Never submits.
AUTOAPPLY_AUTOMATION_ENABLED=false
AUTOAPPLY_AUTOMATION_DRIVER=playwright
AUTOAPPLY_AUTOMATION_INTERACTIVE_TIMEOUT_SEC=1800

# Use your own values here, never in a tracked file. Use absolute document paths.
AUTOAPPLY_PROFILE_FIRST_NAME=
AUTOAPPLY_PROFILE_LAST_NAME=
AUTOAPPLY_PROFILE_EMAIL=
AUTOAPPLY_PROFILE_PHONE=
AUTOAPPLY_PROFILE_LINKEDIN=
AUTOAPPLY_PROFILE_GITHUB=
AUTOAPPLY_PROFILE_WEBSITE=
AUTOAPPLY_PROFILE_LOCATION=
AUTOAPPLY_PROFILE_RESUME_PATH=
AUTOAPPLY_PROFILE_COVER_LETTER_PATH=
AUTOAPPLY_PROFILE_BASE_RESUME_PATH=
AUTOAPPLY_PROFILE_ANSWERS_PATH=data/profile_answers.json

# Optional. These are local defaults; confirm the destination before changing it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ANALYZE_MODEL=llama3.1:8b
OLLAMA_GENERATE_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SEC=60

# Optional local CV library (absolute path; private files stay outside version control).
AUTOAPPLY_CV_WORKSPACE=
